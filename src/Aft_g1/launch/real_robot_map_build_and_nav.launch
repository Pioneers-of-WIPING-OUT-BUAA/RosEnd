<launch>
  <!-- 启动真实机器人硬件驱动 -->
  <!-- 启动WPB_HOME机器人核心驱动 -->
  <node pkg="wpb_home_bringup" type="wpb_home_core" name="wpb_home_core" output="screen">
    <param name="serial_port" type="string" value="/dev/ftdi"/> 
    <rosparam file="$(find wpb_home_bringup)/config/wpb_home.yaml" command="load" />
  </node>

  <!-- 启动Rplidar激光雷达 -->
  <node name="rplidarNode" pkg="rplidar_ros" type="rplidarNode" output="screen">
    <param name="serial_port" type="string" value="/dev/rplidar"/>  
    <param name="serial_baudrate" type="int" value="115200"/>
    <param name="frame_id" type="string" value="laser"/>
    <param name="inverted" type="bool" value="false"/>
    <param name="angle_compensate" type="bool" value="true"/>
    <remap from="scan" to="scan_raw"/>
  </node>
  

  <!-- 启动Kinect2摄像头驱动，发布/kinect2/hd/image_color_rect等话题 -->
  <node pkg="kinect2_bridge" type="kinect2_bridge" name="kinect2_bridge" output="screen"/>

  <!-- 启动激光雷达滤波器 -->
  <node pkg="wpb_home_bringup" type="wpb_home_lidar_filter" name="wpb_home_lidar_filter">
    <param name="pub_topic" value="/scan"/>
  </node>  

  <!-- 启动手柄控制（可选） -->
  <node respawn="true" pkg="joy" type="joy_node" name="wpb_home_joy">
    <param name="dev" type="string" value="/dev/input/js0"/>
    <param name="deadzone" value="0.12"/>
  </node>

  <!-- 启动SLAM建图相关组件 -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping">
    <param name="base_frame" value="base_footprint"/>
    <param name="xmin" value="-5.0"/>
    <param name="ymin" value="-5.0"/>
    <param name="xmax" value="5.0"/>
    <param name="ymax" value="5.0"/>
    <param name="maxUrange" value="10.0"/>
    <param name="delta" value="0.03"/>
    <param name="map_update_interval" value="3.0"/>
  </node>

  <!-- 启动地图服务器 -->
  <node name="map_server" pkg="map_server" type="map_server" args="/home/robot/maps/wxm.yaml"/>

  <!-- 启动Aft_g1项目的所有节点 -->
  <node pkg="Aft_g1" name="action_control" type="action_control.py"/>
  <node pkg="Aft_g1" name="mapping_control" type="mapping_control.py"/>
  <node pkg="Aft_g1" name="abs_pos" type="abs_pos.py"/>
  <node pkg="Aft_g1" name="cur_pos" type="cur_pos.py"/>
  <node pkg="Aft_g1" name="nav_control_node" type="nav_control_node.py"/>
  <node pkg="Aft_g1" name="nav_node" type="nav_node.py" output="screen"/>
  <node pkg="Aft_g1" name="nav_error" type="nav_error.py"/>
  <node pkg="Aft_g1" name="master_node" type="master_node.py" output="screen"/>
  <node pkg="Aft_g1" name="pose_transf" type="pose_transf.py" respawn="true" respawn_delay="5"/>
  <node pkg="Aft_g1" name="pose_error" type="pose_error.py"/>
  <node pkg="Aft_g1" name="warning_sound" type="warning_sound.py"/>
  <node pkg="Aft_g1" name="image_detect" type="image_detect.py"/>

  <!-- 启动move_base导航组件 -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_planner_params.yaml" command="load"/>
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="use_dijkstra" value="true"/>
    <param name="base_local_planner" value="wpbh_local_planner/WpbhLocalPlanner"/>
    <param name="controller_frequency" value="10" type="double"/>
  </node>

  <!-- 机器人描述和状态发布 -->
  <arg name="model" default="$(find wpb_home_bringup)/urdf/wpb_home_mani.urdf"/>
  <arg name="gui" default="false"/>
  <arg name="rvizconfig" default="$(find wpb_home_tutorials)/rviz/slam.rviz"/>

  <param name="robot_description" command="$(find xacro)/xacro $(arg model)"/>
  <param name="use_gui" value="$(arg gui)"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
    <rosparam command="load" file="$(find wpb_home_bringup)/config/wpb_home.yaml"/>
  </node>

  <!-- 运行RViz可视化界面 -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rvizconfig)" required="true"/>
</launch> 